# ── Core ────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for OAuth redirect URIs)
APP_URL=https://jarvis.example.com
# Single-user access token. Pick a long random string; enter the same value in
# Settings → Access on your devices. Protects all data/sync API routes.
JARVIS_ACCESS_TOKEN=

# ── Supabase (cloud storage — optional; app runs demo/local-first without) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (the Jarvis agent) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── WHOOP (developer.whoop.com — create an app, set redirect to
#    {APP_URL}/api/whoop/callback) ───────────────────────────────────────────
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# ── Garmin Connect (unofficial sync — your normal Garmin credentials) ───────
GARMIN_EMAIL=
GARMIN_PASSWORD=

# ── GitHub (projects hub — a fine-grained PAT with repo read access) ────────
GITHUB_TOKEN=
# Optional: comma-separated owner/repo list overriding lib/projectsConfig.ts
# PROJECT_REPOS=alpsisman-tech/seam-app,alpsisman-tech/misafir

# ── n8n (agent actions webhook + scheduled syncs) ────────────────────────────
N8N_WEBHOOK_URL=

# ── Resend (morning briefing email) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=jarvis@yourdomain.com
BRIEFING_TO=alp.sisman@gmail.com
